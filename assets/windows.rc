1 ICON "assets/monolith.ico"
1 VERSIONINFO
// The numeric fields drive Explorer and GetFileVersionInfo; they must track
// the string table below or Windows reports a stale version. `version.rs`
// has a test that fails if these and Cargo.toml drift apart.
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Monolith Desktop"
   VALUE "FileVersion", "0.3.0"
   VALUE "ProductName", "Monolith"
   VALUE "ProductVersion", "0.3.0"
   VALUE "OriginalFilename", "monolith-desktop.exe"
   VALUE "CompanyName", "Monolith"
   VALUE "LegalCopyright", "Copyright (c) 2026 Naveed Gung"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

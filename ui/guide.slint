import { Theme } from "theme.slint";
import { Button, ButtonKind } from "controls.slint";

export struct GuideStep { title: string, body: string, page: int }

// The shell owns the blocking scrim; this card anchors to the current nav item.
export component CoachMark inherits Rectangle {
    in property <bool> shown: false;
    in property <[GuideStep]> steps;
    in-out property <int> step: 0;
    callback step-changed(int);
    in property <length> anchor-y;
    in property <length> rail-width;
    in property <length> viewport-width;
    in property <length> viewport-height;
    callback closed;
    callback finished;
    private property <int> current: clamp(root.step, 0, max(root.steps.length - 1, 0));
    private property <bool> last: root.current >= root.steps.length - 1;
    visible: root.shown;
    z: 30;
    width: min(360px, root.viewport-width - root.rail-width - 26px);
    height: content.preferred-height;
    x: root.rail-width + 14px;
    // Modal content may cover the disabled header/player. This lets the tail
    // meet its nav row even at the 420x380 floor instead of pointing elsewhere.
    y: clamp(root.anchor-y - root.height / 2, 12px,
        max(12px, root.viewport-height - root.height - 12px));
    changed step => { root.step-changed(root.current); }
    changed shown => { if root.shown { next.focus(); } }
    public function focus-primary() { next.focus(); }
    public function handle-key(event: KeyEvent) -> EventResult {
        if event.text == Key.Escape { root.closed(); }
        else if event.text == Key.RightArrow {
            if root.last { root.finished(); } else { root.step = root.current + 1; }
        } else if event.text == Key.LeftArrow {
            if root.current > 0 { root.step = root.current - 1; }
        } else if event.text == Key.Tab || event.text == Key.Backtab {
            if event.modifiers.shift || event.text == Key.Backtab {
                if next.has-focus { cancel.focus(); }
                else if cancel.has-focus && root.current > 0 { back.focus(); }
                else { next.focus(); }
            } else {
                if next.has-focus {
                    if root.current > 0 { back.focus(); } else { cancel.focus(); }
                } else if back.has-focus { cancel.focus(); }
                else { next.focus(); }
            }
        } else if event.text == " " || event.text == "\n" {
            if cancel.has-focus { root.closed(); }
            else if back.has-focus && root.current > 0 { root.step = root.current - 1; }
            else if root.last { root.finished(); }
            else { root.step = root.current + 1; }
        }
        // Consume every key: search, page shortcuts and player cannot activate
        // beneath the scrim, including when focus predates the guide opening.
        return accept;
    }

    Path {
        x: -8px; y: clamp(root.anchor-y - root.y - 8px, 12px, root.height - 28px);
        width: 10px; height: 16px;
        viewbox-width: 10; viewbox-height: 16;
        fill: Theme.raised; stroke: Theme.border; stroke-width: 1px;
        MoveTo { x: 10; y: 0; } LineTo { x: 1; y: 8; }
        LineTo { x: 10; y: 16; } Close {}
    }
    Rectangle {
        border-radius: Theme.radius-panel;
        background: Theme.raised;
        border-width: 1px; border-color: Theme.border;
        accessible-role: text;
        accessible-label: "Monolith guide";
        // Clicking the card body never falls through to a disabled page.
        TouchArea { clicked => { next.focus(); } }
        content := VerticalLayout {
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                spacing: 12px; vertical-stretch: 0;
                Text {
                    text: "QUICK TOUR"; color: Theme.accent;
                    font-size: Theme.type-caption; font-weight: 600;
                    horizontal-stretch: 1;
                }
                Text {
                    text: (root.current + 1) + " / " + root.steps.length;
                    color: Theme.muted; font-size: Theme.type-caption;
                }
            }
            Text {
                text: root.steps.length == 0 ? "" : root.steps[root.current].title;
                color: Theme.foreground; font-size: Theme.type-heading;
                font-weight: 600; wrap: word-wrap;
                accessible-live-region: polite;
            }
            Text {
                text: root.steps.length == 0 ? "" : root.steps[root.current].body;
                color: Theme.secondary; font-size: Theme.type-label; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 4px; vertical-stretch: 0;
                for index in root.steps.length: Rectangle {
                    height: 3px; border-radius: 1.5px;
                    background: index <= root.current ? Theme.accent : Theme.border;
                    animate background { duration: Theme.fast; }
                }
            }
            HorizontalLayout {
                spacing: 6px; vertical-stretch: 0;
                back := Button {
                    kind: ButtonKind.ghost; text: "Back";
                    enabled: root.current > 0;
                    clicked => { root.step = root.current - 1; }
                }
                cancel := Button {
                    kind: ButtonKind.ghost; text: "Close";
                    label: "Close guide";
                    clicked => { root.closed(); }
                }
                Rectangle { horizontal-stretch: 1; }
                next := Button {
                    kind: ButtonKind.primary;
                    text: root.last ? "Done" : "Next";
                    clicked => {
                        if root.last { root.finished(); }
                        else { root.step = root.current + 1; }
                    }
                }
            }
        }
    }
}

/// First-run notice. Dark is the product default, so the user is told once
/// that the theme is theirs to change rather than left wondering.
export component ThemeHint inherits Rectangle {
    in-out property <bool> shown: false;
    callback open-settings;
    callback dismissed;

    height: root.shown ? self.preferred-height : 0px;
    visible: root.shown;
    clip: true;
    background: Theme.accent-soft;

    animate height { duration: Theme.normal; }

    Rectangle {
        x: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.accent-soft;
    }
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 20px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
        Text {
            horizontal-stretch: 1;
            text: "Monolith opens in the dark theme. Light and system themes live in Settings.";
            color: Theme.foreground;
            font-size: Theme.type-body;
            wrap: word-wrap;
        }
        Button {
            kind: ButtonKind.primary;
            text: "Change";
            accessible-label: "Open Settings to change the theme";
            clicked => { root.open-settings(); root.dismissed(); }
        }
        // A glyph rather than an icon: the set has no close mark, and inventing
        // one for a single use would be noise in the icon folder.
        Button {
            kind: ButtonKind.ghost;
            text: "\u{00D7}";
            accessible-label: "Dismiss the theme notice";
            clicked => { root.dismissed(); }
        }
    }
}

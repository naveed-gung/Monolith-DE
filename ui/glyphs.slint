import { Theme } from "theme.slint";

// Shared SVG geometry for navigation and artwork placeholders. Hover changes
// tint only, preserving the icon's shape at every renderer and DPI.
export component NavGlyph inherits Rectangle {
    in property <int> kind;
    // Retain the old state input for callers; it never deforms the SVG artwork.
    in-out property <float> morph: 0;
    in-out property <color> tint: Theme.secondary;
    width: 20px;
    height: 20px;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.kind == 0 ? @image-url("icons/library.svg")
            : root.kind == 1 ? @image-url("icons/music.svg")
            : root.kind == 2 ? @image-url("icons/search.svg")
            : root.kind == 3 ? @image-url("icons/download.svg")
            : @image-url("icons/settings.svg");
        colorize: root.tint;
        accessible-role: none;
    }
    animate tint { duration: Theme.fast; }
}

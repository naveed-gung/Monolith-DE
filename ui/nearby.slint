import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, Card, Caption, SectionLabel, ProgressBar } from "controls.slint";

component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 44px;
    background: root.selected ? Theme.accent-soft : touch.has-hover && root.enabled ? Theme.hover : transparent;
    border-radius: Theme.radius-control;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Text { x: 12px; width: parent.width - 24px; text: root.text; color: root.selected ? Theme.accent : Theme.foreground; overflow: elide; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; }
    }
}

export struct ShareSong { label: string, index: int }

export global SharingState {
    in-out property <[string]> songs;
    in-out property <[ShareSong]> song-results;
    in-out property <string> song-query;
    callback filter-songs;
    in-out property <[string]> devices;
    in-out property <[string]> device-ids;
    in-out property <int> song-index: -1;
    in-out property <int> device-index: -1;
    in-out property <bool> available;
    in-out property <int> method: 0;
    in-out property <bool> batch;
    in-out property <string> receiving-name;
    callback choose-method(int);
    in-out property <bool> busy;
    in-out property <bool> listening;
    in-out property <bool> incoming;
    in-out property <string> incoming-title;
    in-out property <string> incoming-detail;
    in-out property <string> status;
    in-out property <float> progress;
    in-out property <string> destination;
    callback refresh;
    callback send-song(int, int);
    callback receive-song;
    callback cancel;
    callback decide(bool);
    callback open(bool);
    callback close;
}

export component SharePage inherits Rectangle {
    VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            vertical-stretch: 0;
            cross-axis-alignment: center; spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: "Share music"; color: Theme.foreground; font-size: root.width < 400px ? Theme.type-title : Theme.type-display; font-weight: 700; }
                if SharingState.method > 0: Caption { text: SharingState.method == 1 ? "Wi-Fi sharing" : "Bluetooth sharing"; }
            }
            if SharingState.method > 0: Button { text: "Back"; label: "Change sharing method"; enabled: !SharingState.busy && !SharingState.listening; clicked => { SharingState.choose-method(0); } }
            if SharingState.method > 0: Button { text: "Refresh"; label: "Refresh nearby devices and songs"; enabled: !SharingState.busy && !SharingState.listening; clicked => { SharingState.refresh(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start; padding: 4px; spacing: 14px;
                if SharingState.method == 0: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: "Wi-Fi"; label: "Use Wi-Fi";
                        icon: @image-url("icons/wifi.svg");
                        enabled: !SharingState.busy;
                        clicked => { SharingState.choose-method(1); }
                    }
                    Button {
                        text: "Bluetooth"; label: "Use Bluetooth";
                        icon: @image-url("icons/bluetooth.svg");
                        enabled: !SharingState.busy;
                        clicked => { SharingState.choose-method(2); }
                    }
                }
                if SharingState.method == 1 && SharingState.receiving-name != "" && !SharingState.incoming: Card {
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        SectionLabel { text: "VISIBLE AS"; }
                        Text { text: SharingState.receiving-name; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; wrap: word-wrap; }
                        Caption { text: "Ready to receive on this network."; }
                    }
                }
                if SharingState.method > 0 && !SharingState.incoming && !SharingState.listening: VerticalLayout {
                    spacing: 8px;
                    SectionLabel { text: SharingState.batch ? "SELECTED SONGS" : "CHOOSE A SONG"; }
                    if !SharingState.batch && SharingState.songs.length > 0: LineEdit {
                        text <=> SharingState.song-query;
                        placeholder-text: "Find a song by title or artist";
                        accessible-label: "Find a song to share";
                        enabled: !SharingState.busy;
                        edited => { SharingState.filter-songs(); }
                    }
                    if SharingState.batch: Caption { text: "\{SharingState.songs.length} selected songs. Change this selection in Library or Songs."; }
                    Card {
                        height: SharingState.song-results.length > 0 ? 144px : 58px;
                        ListView {
                            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                            for song in SharingState.song-results: Choice {
                                text: song.label;
                                selected: SharingState.batch || SharingState.song-index == song.index;
                                enabled: !SharingState.batch && !SharingState.busy;
                                clicked => { SharingState.song-index = song.index; }
                            }
                        }
                        if SharingState.song-results.length == 0: Text { x: 12px; width: parent.width - 24px; text: SharingState.songs.length == 0 ? "No songs available to share." : "No matching songs."; color: Theme.muted; vertical-alignment: center; }
                    }
                    SectionLabel { text: SharingState.method == 1 ? "NEARBY MONOLITH DEVICES" : "PAIRED DEVICES"; }
                    Card {
                        height: SharingState.devices.length > 0 ? 100px : 64px;
                        ListView {
                            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                            for device[index] in SharingState.devices: Choice {
                                text: device; selected: SharingState.device-index == index; enabled: !SharingState.busy && !SharingState.listening;
                                clicked => { SharingState.device-index = index; }
                            }
                        }
                        if SharingState.devices.length == 0: Text { x: 12px; width: parent.width - 24px; text: SharingState.method == 1 ? "Searching this Wi-Fi… Open Share on the other device." : "No paired devices available."; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; }
                    }
                }
                if SharingState.incoming: Card {
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        SectionLabel { text: "INCOMING SONG"; color: Theme.accent; }
                        Text { text: SharingState.incoming-title; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; wrap: word-wrap; }
                        Caption { text: SharingState.incoming-detail; }
                        Caption { text: "Accept saves this song and adds it to your library. Existing files stay intact."; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Decline"; clicked => { SharingState.decide(false); } }
                            Button { text: "Accept song"; kind: ButtonKind.primary; clicked => { SharingState.decide(true); } }
                        }
                    }
                }
                if SharingState.method > 0: Caption { text: "Received songs: " + SharingState.destination; }
            }
        }
        if SharingState.progress > 0 && SharingState.busy: ProgressBar { progress: SharingState.progress; }
        if SharingState.status != "": Caption { text: SharingState.status; accessible-live-region: polite; }
        HorizontalLayout {
            height: SharingState.method > 0 || SharingState.busy ? 40px : 0px;
            vertical-stretch: 0;
            spacing: 8px;
            if SharingState.method > 0 && !SharingState.busy && !SharingState.listening && !SharingState.incoming: Button {
                text: SharingState.batch ? "Send selected songs" : "Send song"; kind: ButtonKind.primary;
                enabled: SharingState.available && SharingState.song-index >= 0 && SharingState.device-index >= 0;
                clicked => { SharingState.send-song(SharingState.song-index, SharingState.device-index); }
            }
            if SharingState.method == 2 && !SharingState.busy && !SharingState.listening: Button { text: "Receive"; enabled: SharingState.available; clicked => { SharingState.receive-song(); } }
            if SharingState.busy || SharingState.listening: Button { text: "Cancel"; clicked => { SharingState.cancel(); } }
        }
    }
}

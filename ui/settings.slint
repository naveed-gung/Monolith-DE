import { TourTarget, TourAnchor } from "guide.slint";
import { Theme } from "theme.slint";
import { Version } from "version.slint";
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonKind, Chip, Toggle, Card, Caption, SectionLabel, SquareImage, IconButton, ProgressBar } from "controls.slint";

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> action;
    in property <string> action-label;
    in property <string> action2;
    in property <string> action2-label;
    in property <bool> enabled: true;
    in property <bool> enabled2: true;
    in property <int> tour-step: -1;
    in property <length> scroll-offset;
    callback action-area-changed(TourTarget);
    callback clicked;
    callback clicked2;
    min-height: 58px;
    vertical-stretch: 0;
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 14px;
        cross-axis-alignment: center;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.label; color: Theme.foreground; font-size: Theme.type-body; font-weight: 500; wrap: word-wrap; }
            Text { text: root.value; color: Theme.muted; font-size: Theme.type-label; wrap: word-wrap; }
        }
        Button {
            text: root.action; enabled: root.enabled; accessible-label: root.action-label;
            TourAnchor {
                step: root.tour-step; offset: root.scroll-offset;
                viewport-width: root.width; viewport-height: root.height;
                target-width: parent.width; target-height: parent.height;
                measure(area) => { root.action-area-changed(area); }
            }
            clicked => { root.clicked(); }
        }
        if root.action2 != "": Button {
            text: root.action2; enabled: root.enabled2; accessible-label: root.action2-label;
            clicked => { root.clicked2(); }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact;
    in property <int> tour-kind: -1;
    callback tour-area-changed(TourTarget);
    private property <TourTarget> appearance-area;
    private property <TourTarget> folder-area;
    private property <TourTarget> area: root.tour-kind == 1 ? root.appearance-area : root.folder-area;
    changed area => { root.tour-area-changed(self.area); }
    private property <bool> reposition;
    changed tour-kind => { if root.tour-kind > 0 { root.reposition = true; } }
    Timer {
        interval: 50ms; running: root.reposition;
        triggered => {
            root.reposition = false;
            scroll.viewport-y = min(0px, scroll.viewport-y + scroll.absolute-position.y + 8px - root.area.y);
        }
    }
    in-out property <bool> light;
    in-out property <bool> theme-follow-system;
    in property <bool> system-light;
    in-out property <bool> glass;
    in property <bool> glass-available;
    in-out property <bool> low-power;
    in property <bool> tray-available;
    in property <string> downloader-path;
    in property <string> ffmpeg-path;
    in property <string> ytdlp-info;
    in property <string> ffmpeg-info;
    in property <bool> ytdlp-found;
    in property <bool> ffmpeg-found;
    in property <bool> ytdlp-managed;
    in property <bool> ffmpeg-managed;
    in property <bool> tool-busy;
    in property <float> tool-progress;
    in property <string> tool-status;
    in property <string> download-folder;
    in property <string> data-folder;
    in property <bool> downloading;
    callback hide-to-tray;
    callback import-files(bool);
    callback import-playlist;
    callback prune-missing;
    callback glass-changed(bool);
    callback power-changed(bool);
    callback theme-changed(int);
    callback choose-downloader;
    callback choose-ffmpeg;
    callback install-tool(int);
    callback cancel-tool;
    callback choose-download-folder;
    // The developer card has no dismiss, hide or edit path. Its text arrives
    // from Rust already decoded, so nothing here is a plain string in the
    // binary. The card belongs in the product; what stays out of the published
    // repository is the plaintext, and there is none to publish.
    in property <string> dev-name;
    in property <string> dev-role;
    in property <string> dev-portfolio;
    in property <string> dev-github-url;
    in property <string> dev-portfolio-url;
    in property <image> dev-photo;
    callback open-link(string);
    in property <string> update-status;
    in property <bool> update-busy;
    in property <bool> update-available;
    in property <bool> update-ready;
    callback check-update;
    callback download-update;
    callback install-update;
    callback cancel-update;

    VerticalLayout {
        spacing: 18px;
        HorizontalLayout {
            min-height: 52px;
            max-height: 52px;
            vertical-stretch: 0;
            cross-axis-alignment: center;
            spacing: 4px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: "Settings"; color: Theme.foreground; font-size: Theme.type-display; font-weight: 700; overflow: elide; }
                Text { text: "Keep Monolith quiet, local, and light on your system."; color: Theme.secondary; font-size: Theme.type-body; overflow: elide; }
            }
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            // Track the viewport rather than the padded parent so cards stop
            // overflowing the right edge and sitting under the scrollbar.
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 4px;
                spacing: 16px;
                alignment: start;
                SectionLabel { text: "APPEARANCE"; }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 12px : 20px;
                        spacing: 10px;
                        // The label sits on its own line so the chips get the
                        // full card width. Sharing a row meant the chips and
                        // the label together outgrew the 420 px floor and the
                        // last chip was clipped by the card edge.
                        Text { text: "Theme"; color: Theme.foreground; font-size: Theme.type-body; font-weight: 500; }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 7px;
                            TourAnchor {
                                step: root.tour-kind; viewport-width: root.width; viewport-height: root.height; offset: scroll.viewport-y;
                                target-width: system-chip.width + light-chip.width + dark-chip.width + 14px;
                                target-height: parent.height;
                                measure(area) => { root.appearance-area = area; }
                            }
                            system-chip := Chip {
                                text: "System";
                                selected: root.theme-follow-system;
                                clicked => { root.theme-follow-system = true; root.theme-changed(0); }
                            }
                            light-chip := Chip {
                                text: "Light";
                                selected: !root.theme-follow-system && root.light;
                                clicked => { root.theme-follow-system = false; root.light = true; root.theme-changed(1); }
                            }
                            dark-chip := Chip {
                                text: "Dark";
                                selected: !root.theme-follow-system && !root.light;
                                clicked => { root.theme-follow-system = false; root.light = false; root.theme-changed(2); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Caption { text: root.theme-follow-system ? "Follows your system appearance." : "Uses your saved Monolith theme."; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Toggle {
                            text: "Translucent background";
                            description: root.glass-available ? "Use Windows acrylic behind Monolith." : "Unavailable on this system.";
                            enabled: root.glass-available;
                            checked <=> root.glass;
                            toggled(value) => { root.glass-changed(value); }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        Toggle {
                            text: "Low-power rendering";
                            description: "Use the software renderer for the smallest footprint. Applies after restart.";
                            checked <=> root.low-power;
                            toggled(value) => { root.power-changed(value); }
                        }
                    }
                }
                SectionLabel { text: "LIBRARY"; }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 12px : 20px;
                        spacing: 12px;
                        Text { text: "Import music"; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; }
                        Caption { text: "Music/Monolith and your save folder are checked automatically while Monolith is open. New files appear after copying settles. Other folders can be imported below."; }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            Button { text: root.compact ? "Files" : "Import files"; label: "Import audio files"; icon: @image-url("icons/plus.svg"); clicked => { root.import-files(false); } }
                            Button { text: root.compact ? "Folder" : "Import folder"; label: "Import music folder"; icon: @image-url("icons/folder.svg"); clicked => { root.import-files(true); } }
                            Button { label: "Import a playlist file"; icon: @image-url("icons/import.svg"); icon-only: true; clicked => { root.import-playlist(); } }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        SettingRow {
                            label: "Find missing files";
                            value: "Forget library entries whose audio file is gone. Files are never deleted.";
                            action: "Scan";
                            action-label: "Scan for missing files";
                            enabled: true;
                            clicked => { root.prune-missing(); }
                        }
                        if root.tray-available: Rectangle { height: 1px; background: Theme.border; }
                        if root.tray-available: SettingRow {
                            label: "Keep listening in the tray";
                            value: "Hide the window without stopping playback.";
                            action: "Hide";
                            action-label: "Hide to tray";
                            clicked => { root.hide-to-tray(); }
                        }
                        Caption { text: "Library data: " + root.data-folder; color: Theme.muted; }
                    }
                }
                SectionLabel { text: "DOWNLOADS"; }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 12px : 20px;
                        SettingRow {
                            label: "yt-dlp";
                            value: root.ytdlp-info;
                            action: "Choose";
                            action-label: "Choose yt-dlp executable";
                            action2: root.ytdlp-managed ? "Update" : (root.ytdlp-found ? "" : "Download");
                            action2-label: root.ytdlp-managed ? "Update the managed yt-dlp" : "Download yt-dlp from its official release";
                            enabled: !root.downloading && !root.tool-busy;
                            enabled2: !root.downloading && !root.tool-busy;
                            clicked => { root.choose-downloader(); }
                            clicked2 => { root.install-tool(0); }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        SettingRow {
                            label: "FFmpeg";
                            value: root.ffmpeg-info;
                            action: "Choose";
                            action-label: "Choose ffmpeg executable";
                            action2: root.ffmpeg-managed ? "Update" : (root.ffmpeg-found ? "" : "Download");
                            action2-label: root.ffmpeg-managed ? "Update the managed FFmpeg" : "Download FFmpeg from an official build";
                            enabled: !root.downloading && !root.tool-busy;
                            enabled2: !root.downloading && !root.tool-busy;
                            clicked => { root.choose-ffmpeg(); }
                            clicked2 => { root.install-tool(1); }
                        }
                        if root.tool-busy || root.tool-status != "": VerticalLayout {
                            spacing: 8px;
                            if root.tool-busy: ProgressBar { progress: root.tool-progress / 100; }
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Caption { horizontal-stretch: 1; text: root.tool-status; }
                                if root.tool-busy: Button { text: "Cancel"; clicked => { root.cancel-tool(); } }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        SettingRow {
                            label: "Download folder";
                            tour-step: root.tour-kind; scroll-offset: scroll.viewport-y;
                            action-area-changed(area) => {
                                root.folder-area = { x: area.x - 4px, y: area.y - 4px,
                                    width: area.width + 8px, height: area.height + 8px };
                            }
                            value: root.download-folder;
                            action: "Choose";
                            action-label: "Choose download folder";
                            enabled: !root.downloading;
                            clicked => { root.choose-download-folder(); }
                        }
                        Rectangle { height: 8px; }
                        Caption { text: "YouTube extraction needs yt-dlp. MP3 conversion also needs FFmpeg. Missing helpers can be downloaded and verified here."; }
                    }
                }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 12px : 20px;
                        spacing: 12px;
                        SectionLabel { text: "APP UPDATES"; }
                        Text { text: "Monolith " + Version.value; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; }
                        Caption { text: root.update-status; accessible-live-region: polite; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Check for updates"; enabled: !root.update-busy; clicked => { root.check-update(); } }
                            if root.update-busy: Button { text: "Cancel"; clicked => { root.cancel-update(); } }
                            if root.update-available && !root.update-ready && !root.update-busy: Button {
                                text: "Download"; kind: ButtonKind.primary; enabled: !root.update-busy;
                                clicked => { root.download-update(); }
                            }
                            if root.update-ready && !root.update-busy: Button {
                                text: "Open installer"; kind: ButtonKind.primary; enabled: !root.update-busy;
                                clicked => { root.install-update(); }
                            }
                        }
                        Caption { text: "Updates use GitHub over HTTPS. Downloads require your click and stay under 100 MB. Your library stays intact."; }
                    }
                }
                SectionLabel { text: "DEVELOPER"; }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 12px : 20px;
                        spacing: 16px;
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 16px;
                            // Local portrait when available; public mark otherwise. Neither needs a private embedded payload.
                            SquareImage {
                                height: 60px;
                                radius: Theme.radius-panel;
                                placeholder: Theme.hero;
                                source: root.dev-photo;
                                label: root.dev-name;
                            }
                            VerticalLayout {
                                alignment: center;
                                vertical-stretch: 0;
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text { text: root.dev-name; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; overflow: elide; }
                                Text { text: root.dev-role; color: Theme.secondary; font-size: Theme.type-label; overflow: elide; }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        // Buttons rather than static text: the links have to work,
                        // and the URL never appears as a literal in the interface.
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            Button {
                                text: "GitHub";
                                accessible-label: "Open the developer's GitHub profile in your browser";
                                clicked => { root.open-link(root.dev-github-url); }
                            }
                            Button {
                                text: "Portfolio";
                                accessible-label: "Open the developer's portfolio in your browser";
                                clicked => { root.open-link(root.dev-portfolio-url); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Caption { text: root.dev-portfolio; }
                    }
                }
                SectionLabel { text: "ABOUT"; }
                Card {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        vertical-stretch: 0;
                        padding: root.compact ? 12px : 20px;
                        spacing: 14px;
                        SquareImage {
                            height: 44px;
                            radius: Theme.radius-control;
                            placeholder: Theme.accent-soft;
                            source: @image-url("../assets/monolith-mark.png");
                            label: "Monolith Desktop";
                        }
                        VerticalLayout {
                            alignment: center;
                            vertical-stretch: 0;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text { text: "Monolith Desktop"; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; }
                            Caption { text: "Version " + Version.value + " · Native music player"; }
                        }
                    }
                }
            }
        }
    }
}

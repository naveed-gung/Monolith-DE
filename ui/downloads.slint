import { TourTarget, TourAnchor } from "guide.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonKind, TextField, Chip, ProgressBar, Card, Caption, SectionLabel } from "controls.slint";

export component DownloadsPage inherits Rectangle {
    in property <bool> compact;
    in property <int> tour-kind: -1;
    callback tour-area-changed(TourTarget);
    private property <TourTarget> link-area;
    private property <TourTarget> save-area;
    private property <TourTarget> area: root.tour-kind == 1 ? root.link-area : root.save-area;
    changed area => { root.tour-area-changed(self.area); }
    private property <bool> reposition;
    changed tour-kind => { if root.tour-kind > 0 { root.reposition = true; } }
    Timer {
        interval: 50ms; running: root.reposition;
        triggered => {
            root.reposition = false;
            scroll.viewport-y = min(0px, scroll.viewport-y + scroll.absolute-position.y + 8px - root.area.y);
        }
    }
    in property <string> download-folder;
    in property <string> download-status;
    in property <string> download-history;
    in property <float> download-progress;
    in property <bool> downloading;
    in-out property <string> url;
    in-out property <int> format;
    callback start-download(string, bool);
    callback cancel-download;

    VerticalLayout {
        spacing: 18px;
        VerticalLayout {
            min-height: 52px;
            max-height: 52px;
            vertical-stretch: 0;
            Text { text: "Downloads"; color: Theme.foreground; font-size: Theme.type-display; font-weight: 700; overflow: elide; }
            Text { text: "Your music, ready for offline listening."; color: Theme.secondary; font-size: Theme.type-body; overflow: elide; }
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 4px;
                spacing: 20px;
                alignment: start;
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: root.compact ? 16px : 24px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 40px; height: 40px;
                                border-radius: Theme.radius-control;
                                background: Theme.accent-soft;
                                Image { x: 10px; y: 10px; width: 20px; height: 20px; source: @image-url("icons/download.svg"); colorize: Theme.accent; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Save from a link"; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; }
                                Caption { text: "YouTube and YouTube Music"; }
                            }
                        }
                        TextField {
                            TourAnchor {
                                step: root.tour-kind; viewport-width: root.width; viewport-height: root.height; offset: scroll.viewport-y;
                                target-width: parent.width; target-height: parent.height;
                                measure(area) => { root.link-area = area; }
                            }
                            icon: @image-url("icons/music.svg");
                            placeholder: "Paste your music link";
                            label: "YouTube or YouTube Music download link";
                            enabled: !root.downloading;
                            text <=> root.url;
                            accepted(text) => {
                                if text != "" && !root.downloading { root.start-download(text, root.format == 1); }
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            Caption { text: "Audio format"; }
                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;
                                Chip { text: "M4A"; selected: root.format == 0; enabled: !root.downloading; clicked => { root.format = 0; } }
                                Chip { text: "MP3"; selected: root.format == 1; enabled: !root.downloading; clicked => { root.format = 1; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Caption { text: root.format == 0 ? "Original audio. Requires yt-dlp." : "Converted audio. Requires yt-dlp and FFmpeg."; }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            cross-axis-alignment: center;
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.downloading ? "Saving audio" : "Save to library";
                                color: Theme.foreground;
                                font-size: Theme.type-body;
                                font-weight: 600;
                            }
                            if root.downloading: Text { text: "\{round(root.download-progress)}%"; color: Theme.accent; font-size: Theme.type-body; font-family: "Consolas"; }
                            Button {
                                TourAnchor {
                                    step: root.tour-kind; viewport-width: root.width; viewport-height: root.height; offset: scroll.viewport-y;
                                    target-width: parent.width; target-height: parent.height;
                                    measure(area) => { root.save-area = area; }
                                }
                                kind: root.downloading ? ButtonKind.danger : ButtonKind.primary;
                                text: root.downloading ? "Cancel" : "Download";
                                enabled: root.downloading || root.url != "";
                                clicked => {
                                    if root.downloading { root.cancel-download(); }
                                    else { root.start-download(root.url, root.format == 1); }
                                }
                            }
                        }
                        if root.downloading: ProgressBar { progress: root.download-progress / 100; }
                        Caption { text: root.download-status; accessible-live-region: polite; }
                        Caption { text: root.download-folder == "" || root.download-folder == "Not selected" ? "Choose a save folder in Settings." : "Save folder: " + root.download-folder; }
                    }
                }
                SectionLabel { text: "RECENTLY SAVED"; }
                Card {
                    horizontal-stretch: 1;
                    min-height: 110px;
                    VerticalLayout {
                        padding: root.compact ? 16px : 24px;
                        spacing: 8px;
                        if root.download-history == "": VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "Your next listen starts here"; color: Theme.foreground; font-size: Theme.type-heading; font-weight: 600; wrap: word-wrap; }
                            Caption { text: "Completed downloads appear here and in your library."; }
                        }
                        if root.download-history != "": Text { text: root.download-history; color: Theme.secondary; font-size: Theme.type-body; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}
